{% extends "layout.njk" %}

{% set isRegister = (mode == 'register') %}

{% block title %}{{ t('registerTitle') if isRegister else t('loginTitle') }} – {{ t('appName') }}{% endblock %}

{% block head %}
<meta name="robots" content="noindex">
<style>
  .auth-card {
    background: #fff; border: 1px solid var(--border); border-radius: 0.5rem;
    padding: 1.25rem 1rem; max-width: 28rem; margin: 0 auto;
  }
  .auth-card h1 { font-size: 1.5rem; }
  .field { margin-bottom: 1rem; }
  .field label { display: block; font-weight: 600; margin-bottom: 0.25rem; }
  .field input {
    display: block; width: 100%; font: inherit; font-size: 1rem; /* 16px: no zoom on iOS */
    padding: 0.7rem 0.75rem; min-height: 48px;
    border: 1px solid #b9b0a3; border-radius: 0.375rem; background: #fff; color: var(--fg);
  }
  .field input:focus { outline: 3px solid rgba(138, 59, 18, 0.35); border-color: var(--accent); }
  .hint { font-size: 0.875rem; color: var(--muted); margin: 0.25rem 0 0; }
  .btn {
    display: block; width: 100%; font: inherit; font-weight: 600; cursor: pointer;
    min-height: 48px; padding: 0.7rem 1rem; border: 0; border-radius: 0.375rem;
    background: var(--accent); color: #fff;
  }
  .btn:hover, .btn:focus { background: #6e2e0d; }
  .errors {
    background: #fdecea; border-left: 4px solid #b3261e; color: #5f1410;
    padding: 0.75rem 1rem; margin-bottom: 1rem; border-radius: 0.25rem;
  }
  .errors ul { margin: 0.25rem 0 0; padding-left: 1.25rem; }
  .privacy-note { font-size: 0.875rem; color: var(--muted); margin: 1rem 0 0; }
  .switch-form { margin: 1rem 0 0; text-align: center; }
  .switch-form a { display: inline-block; padding: 0.5rem 0.25rem; }
  @media (min-width: 48rem) { .auth-card { padding: 2rem; } }
</style>
{% endblock %}

{% block content %}
<section class="auth-card" id="{{ mode }}-form">
  <h1>{{ t('registerTitle') if isRegister else t('loginTitle') }}</h1>
  <p class="muted">{{ t('registerIntro') if isRegister else t('loginIntro') }}</p>

  {% if errors and errors.length %}
  <div class="errors" role="alert">
    <strong>{{ t('errorsHeading') }}</strong>
    <ul>
      {% for e in errors %}<li>{{ e }}</li>{% endfor %}
    </ul>
  </div>
  {% endif %}

  <form method="post" action="/{{ mode }}?lang={{ lang }}" novalidate>
    <input type="hidden" name="_csrf" value="{{ csrfToken }}">
    <div class="field">
      <label for="email">{{ t('emailLabel') }}</label>
      <input id="email" name="email" type="email" inputmode="email" autocomplete="email"
             autocapitalize="none" spellcheck="false" required maxlength="254" value="{{ email }}">
    </div>
    <div class="field">
      <label for="password">{{ t('passwordLabel') }}</label>
      <input id="password" name="password" type="password" required maxlength="200"
             {% if isRegister %}minlength="8" autocomplete="new-password" aria-describedby="password-hint"{% else %}autocomplete="current-password"{% endif %}>
      {% if isRegister %}<p class="hint" id="password-hint">{{ t('passwordHint') }}</p>{% endif %}
    </div>
    <button type="submit" class="btn">{{ t('registerSubmit') if isRegister else t('loginSubmit') }}</button>
  </form>

  {% if isRegister %}
  <p class="privacy-note">{{ t('privacyNote') }}</p>
  <p class="switch-form">{{ t('haveAccount') }} <a href="/login?lang={{ lang }}">{{ t('loginInstead') }}</a></p>
  {% else %}
  <p class="switch-form">{{ t('noAccount') }} <a href="/register?lang={{ lang }}">{{ t('registerInstead') }}</a></p>
  {% endif %}
</section>
{% endblock %}
