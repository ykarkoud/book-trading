{
  "name": "book-exchange",
  "version": "0.1.0",
  "private": true,
  "description": "Book exchange platform (walking skeleton): Express + Nunjucks + Knex, German/English.",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "NODE_ENV=development node src/server.js",
    "test": "jest"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "better-sqlite3": "^12.4.1",
    "express": "^5.1.0",
    "i18next": "^25.5.2",
    "knex": "^3.1.0",
    "mysql2": "^3.15.0",
    "nunjucks": "^3.2.4"
  },
  "devDependencies": {
    "jest": "^30.1.3",
    "supertest": "^7.1.4"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "<rootDir>/tests/**/*.test.js"
    ]
  }
}
